# Local server
PORT=10000
NODE_ENV=development
APP_BASE_URL=http://localhost:10000
SESSION_SECRET=replace-with-a-long-random-string
SESSION_DAYS=30

# Neon: use the pooled connection string (-pooler in hostname)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Gemini AI for SMU.Link
# Keep the API key on the server only. Never expose it in public/local.js.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=20000

# Google OAuth (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao Login (REST API key + Client secret)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
