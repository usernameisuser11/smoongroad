# Local server
PORT=10000
NODE_ENV=development
APP_BASE_URL=http://localhost:10000
SESSION_SECRET=replace-with-a-long-random-string
SESSION_DAYS=30
INTERNAL_APP_PORT=10001

# Neon: use the pooled connection string (-pooler in hostname)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Gemini AI for SMU.Link
# Keep the API key on the server only. Never expose it in public/local.js.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
AI_PRIMARY_RETRIES=1
AI_RETRY_BASE_MS=700
GEMINI_ATTEMPT_TIMEOUT_MS=8000
AI_TIMEOUT_MS=30000

# SMU.Link trust & safety
# Comma-separated OAuth account emails allowed to use the admin moderation panel.
# Example: admin1@example.com,admin2@example.com
ADMIN_EMAILS=

# Google OAuth (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao Login (REST API key + Client secret)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
