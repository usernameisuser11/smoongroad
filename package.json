{
  "name": "smoongroad",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "상명대학교 서울캠퍼스 전공 탐색 및 대학생활 로드맵 서비스",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
